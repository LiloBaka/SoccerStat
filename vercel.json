{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd SoccerStat && npm ci",
  "buildCommand": "cd SoccerStat && npm run build",
  "outputDirectory": "SoccerStat/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
