# Server-side secret used by the local Vite proxy and by Vercel Functions.
# Never prefix secrets with VITE_, because Vite exposes VITE_* values to the browser bundle.
FOOTBALL_DATA_API_KEY=replace_with_your_football_data_org_token

# Optional. Keep '/' for Vercel. Change only when deploying under a sub-path.
VITE_BASE_PATH=/
